# ShanHaiEdu API environment example
# Only variable names and placeholder descriptions are allowed here.
# Copy to apps/api/.env for local use, then replace placeholders locally.
# Never commit real keys, tokens, provider URLs with private credentials, or account identifiers.

# Runtime paths
STORAGE_ROOT=<local runtime storage root, for example storage or storage-real-demo>
WORKFLOW_ROOT=<workflow config root, usually workflow>
CAPABILITIES_PATH=<video capabilities JSON path>

# Backend runtime mode
PROVIDER_MODE=<fake | real | deepseek | minimax; controls text LLM only>
VIDEO_PROVIDER_MODE=<placeholder | fake | real; controls video provider only>
TTS_PROVIDER_MODE=<placeholder | real; controls final video narration audio only>
BACKEND_API_TOKEN=<optional backend bearer token; leave empty only for isolated local demo>
CORS_ORIGINS=<comma separated frontend origins, for example local dev origins>

# Text LLM provider: Minimax
MINMAX_API_KEY=<server-side Minimax API key>
MINMAX_BASE_URL=<Minimax API base URL>
MINMAX_TEXT_MODEL=<Minimax text model name>
MINMAX_VIDEO_MODEL=<reserved Minimax video model name>
MINMAX_TTS_MODEL=<reserved Minimax TTS model name>

# TTS provider: Minimax official naming, preferred by new code
MINIMAX_API_KEY=<server-side Minimax API key; preferred, MINMAX_API_KEY remains compatible>
MINIMAX_BASE_URL=<Minimax API base URL; preferred, MINMAX_BASE_URL remains compatible>
MINIMAX_TTS_MODEL=<Minimax TTS model name, default speech-2.8-hd>
MINIMAX_TTS_VOICE_ID=<Minimax voice id, default Chinese (Mandarin)_Gentleman>

# Text LLM provider: DeepSeek
DEEPSEEK_API_KEY=<server-side DeepSeek API key>
DEEPSEEK_BASE_URL=<DeepSeek API base URL>
DEEPSEEK_MODEL=<DeepSeek chat model name>

# Image provider: project-local imagegen-myself skill
IMAGEGEN_MYSELF_API_KEY=<server-side image provider API key>
IMAGEGEN_MYSELF_BASE_URL=<OpenAI-compatible image API base URL>
IMAGEGEN_MYSELF_PRIMARY_API_KEY=<optional primary image provider API key>
IMAGEGEN_MYSELF_PRIMARY_BASE_URL=<optional primary image provider base URL>
IMAGEGEN_MYSELF_FALLBACK_API_KEY=<optional fallback image provider API key>
IMAGEGEN_MYSELF_FALLBACK_BASE_URL=<optional fallback image provider base URL>
NEWAPI_API_KEY=<optional NewAPI-compatible image API key alias>
NEWAPI_BASE_URL=<optional NewAPI-compatible image base URL alias>
PINAI_API_KEY=<optional PinAI-compatible image API key alias>
PINAI_BASE_URL=<optional PinAI-compatible image base URL alias>
AIRCODE_API_KEY=<optional AirCode-compatible image API key alias>
AIRCODE_PROVIDER_TIMEOUT=<optional image provider timeout seconds>

# Video provider: Octo / OTU NewAPI
OCTO_API_KEY=<server-side Octo or OTU API key>
OCTO_BASE_URL=<Octo or OTU API base URL>
OCTO_VIDEO_PROVIDER=<video provider label, usually octo>
VIDEO_MODEL=<optional API and T075 default video model override>
OMNI_DEFAULT_MODEL=<optional videogen helper default Omni model>
OMNI_DEFAULT_SIZE=<optional videogen helper default Omni size>
NEWAPI_DEFAULT_MODEL=<optional videogen helper default NewAPI video model>
NEWAPI_DEFAULT_SIZE=<optional videogen helper default NewAPI video size>

# FFmpeg
# Current backend compose code resolves ffmpeg from PATH with shutil.which("ffmpeg").
# FFMPEG_PATH is reserved as an ops note until backend code explicitly consumes it.
FFMPEG_PATH=<optional absolute ffmpeg executable path for operator reference>
