{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feedback_record.schema.json",
  "title": "反馈记录",
  "type": "object",
  "required": ["feedback_id", "project_id", "timing", "submitted_at"],
  "properties": {
    "feedback_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "timing": { "type": "string", "enum": ["on_delivery", "on_next_session_open"] },
    "satisfaction_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "class_effect_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "仅 on_next_session_open 有效"
    },
    "student_reaction": { "type": "string" },
    "free_comment": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" }
  }
}
